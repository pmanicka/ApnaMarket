# ApnaMarket — Environment Variables
# ─────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit the `.env` file to git.
#
# How to get these values:
#   1. Go to https://supabase.com and create a free project
#   2. In your project: Settings → API
#   3. Copy "Project URL" → EXPO_PUBLIC_SUPABASE_URL
#   4. Copy "anon public" key → EXPO_PUBLIC_SUPABASE_ANON_KEY

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Default community ID to scope all listings/users
# Create one row in the `communities` table and paste its UUID here
EXPO_PUBLIC_DEFAULT_COMMUNITY_ID=your-community-uuid-here
